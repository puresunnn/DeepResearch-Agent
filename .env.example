# 必填：在 llm.talkweb.com.cn 创建的 API 令牌（不是网页登录密码）。
NEWAPI_API_KEY=
NEWAPI_BASE_URL=https://llm.talkweb.com.cn/v1
AGENT_MODEL=gpu-deepseek-v4-flash

# 必填其一：搜索服务独立于模型网关。默认选择 Serper。
SEARCH_PROVIDER=serper
SERPER_API_KEY=
IQS_API_KEY=

# 可选：网页获取失败时尝试 Jina；没有 Key 仍可直接读取公开网页/PDF。
JINA_API_KEY=

# 默认不启用额外摘要模型，先建立 Plus 单模型基线。
EXTRACTOR_ENABLED=false
EXTRACTOR_MODEL=qwen3.7-flash
EXTRACTOR_THRESHOLD_CHARS=20000

# 离线打分；只在评测阶段接触 gold，永不传给 Agent。
JUDGE_MODEL=qwen3.7-max
# 网关支持时可设 {"enable_thinking":false}；默认不发送厂商专属参数。
LLM_EXTRA_BODY={}
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
# 单次请求重试耗尽后的整题恢复次数；保留消息/证据，不重放已执行工具。
TASK_API_RECOVERIES=1
# 连续协议错误后允许重新生成格式的次数；耗尽后有界收尾。
PROTOCOL_MAX_REPAIRS=2
TEMPERATURE=0.1
MAX_ROUNDS=30
TASK_TIMEOUT_SECONDS=600
FINAL_RESERVE_SECONDS=45
MAX_SEARCH_QUERIES=30
MAX_VISIT_PAGES=15
MAX_TOOL_CONCURRENCY=3
TOOL_TIMEOUT_SECONDS=25
MAX_CONTEXT_CHARS=100000
MAX_TOOL_RESULT_CHARS=20000
MAX_DOWNLOAD_BYTES=15000000

# 留空表示不估算费用；如填写，单位是人民币/百万 token，需按网关账单确认。
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
CACHED_INPUT_PRICE_PER_MILLION=

# 搜索费用独立于模型费用；填写当前套餐折算的人民币/1000 次搜索请求价格。
SEARCH_PRICE_PER_1000_REQUESTS=

# 可选历史基准，默认不把 2510 文件名推断成题目的“当前日期”。
RESEARCH_AS_OF=
